#!/system/bin/sh

# Watch wireless ADB TCP sessions and post shell-owned connection alerts.

PERSIST_PATH="/data/adb/wadbd"
PID_FILE="$PERSIST_PATH/monitor.pid"
CONFIG_FILE="$PERSIST_PATH/notify_conn"
TAG="wadbd_session"
NOTIF_ID=2020

echo $$ > "$PID_FILE"

clear_notification() {
    su 2000 -c "service call notification 8 s16 'com.android.shell' s16 'com.android.shell' s16 '$TAG' i32 $NOTIF_ID i32 0" >/dev/null 2>&1
    su 2000 -c "cmd notification snooze --for 1 '0|com.android.shell|$NOTIF_ID|$TAG|2000'" >/dev/null 2>&1
}

post_notification() {
    local text="$1"
    su 2000 -c "cmd notification post -S bigtext -t 'Wireless ADB Active' -i @android:drawable/stat_sys_warning '$TAG' '$text'" >/dev/null 2>&1
}

cleanup() {
    clear_notification
    rm -f "$PID_FILE"
    exit 0
}

trap cleanup INT TERM HUP

prev_count=0
prev_clients=""

while true; do
    # Missing configuration means notifications are enabled.
    if [ -f "$CONFIG_FILE" ] && [ "$(cat "$CONFIG_FILE" 2>/dev/null | tr -d '[:space:]')" = "0" ]; then
        if [ "$prev_count" -gt 0 ]; then
            clear_notification
            prev_count=0
            prev_clients=""
        fi
        sleep 5
        continue
    fi

    port=$(getprop service.adb.tcp.port 2>/dev/null | tr -d '[:space:]')
    if [ -z "$port" ] || [ "$port" = "-1" ] || [ "$port" = "0" ]; then
        if [ "$prev_count" -gt 0 ]; then
            clear_notification
            prev_count=0
            prev_clients=""
        fi
        sleep 3
        continue
    fi

    conns=$(ss -Htn state established "( sport = :$port )" 2>/dev/null)
    # ss columns are state, queues, local endpoint, then remote/client endpoint.
    external_conns=$(echo "$conns" | awk '{print $5}' | grep -vE '^(127\.0\.0\.1|\[::1\]):' | grep -v '^$')

    if [ -n "$external_conns" ]; then
        count=$(echo "$external_conns" | wc -l | tr -d '[:space:]')
        client_ips=$(echo "$external_conns" | sed -E 's/:[0-9]+$//' | sed 's/^\[//;s/\]$//' | sort -u | paste -sd, - | sed 's/,/, /g')

        if [ "$count" != "$prev_count" ] || [ "$client_ips" != "$prev_clients" ]; then
            if [ "$count" -eq 1 ]; then
                text="Connected: $client_ips"
            else
                text="$count active sessions: $client_ips"
            fi
            post_notification "$text"
            prev_count=$count
            prev_clients="$client_ips"
        fi
        sleep 2
    else
        if [ "$prev_count" -gt 0 ]; then
            clear_notification
            prev_count=0
            prev_clients=""
        fi
        sleep 3
    fi
done
