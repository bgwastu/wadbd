#!/bin/sh

# WADBD - Wireless ADB Controller (fork: interface binding)
# Forked from: https://github.com/Magisk-Modules-Alt-Repo/wadbd
# Adds per-interface iptables binding for ADB

GREEN='\033[0;32m'
PINK='\033[1;35m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

MODULE_PATH="/data/adb/modules/wadbd"
BIND_FILE="$MODULE_PATH/bind_ifaces"
ADB_PORT=$(getprop service.adb.tcp.port)

usage() {
    local cmd=$(basename "$0")
    echo -e "${PINK}Usage: $cmd [on <port>|off|status|enable-on-boot <port>|disable-on-boot]${NC}"
    echo -e "${PINK}       $cmd bind <interface>|unbind <interface>|unbind-all|bind-status${NC}"
    echo -e "\n${YELLOW}Commands:${NC}"
    echo -e "  $cmd on <port>              - Enable wireless ADB on the specified port."
    echo -e "  $cmd off                    - Disable wireless ADB."
    echo -e "  $cmd status                 - Show the status of wireless ADB."
    echo -e "  $cmd enable-on-boot <port>  - Enable wireless ADB on boot with the specified port."
    echo -e "  $cmd disable-on-boot        - Disable wireless ADB on boot."
    echo -e "  $cmd bind <interface>       - Restrict ADB to a specific network interface via iptables."
    echo -e "  $cmd unbind <interface>     - Remove interface restriction."
    echo -e "  $cmd unbind-all             - Remove all interface restrictions."
    echo -e "  $cmd bind-status            - Show current binding state."
    echo -e "  $cmd list-interfaces        - List available network interfaces."
    echo -e "  $cmd --import-key <path>    - Import an adbkey.pub file to authorize ADB without prompt."
    echo -e "  $cmd --backup <path>        - Backup authorized adb_keys"
    echo -e "  $cmd --restore <path>       - Restore backed up adb_keys"
    echo -e "  $cmd --clear-keys           - Revokes all authorized Keys"
    echo -e "\n${YELLOW}Note:${NC} If you don't specify a port, it will use the default port 5555."
    exit 1
}

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo -e "${PINK}Error: This script must be run as root.${NC}"
        exit 1
    fi
}

# ─── Interface Binding Core ───────────────────────────────────────

get_adb_port() {
    local port=$(getprop service.adb.tcp.port)
    if [ -z "$port" ] || [ "$port" = "-1" ]; then
        echo ""
    else
        echo "$port"
    fi
}

apply_iptables_rules() {
    local port=$1
    local bind_file=$2

    # Flush existing ADB rules
    flush_adb_rules "$port"

    if [ ! -f "$bind_file" ] || [ ! -s "$bind_file" ]; then
        # No bindings: no iptables restrictions (ADB open on all interfaces)
        return 0
    fi

    # Default DROP on ADB port
    iptables -A INPUT -p tcp --dport "$port" -j DROP

    # Always allow localhost
    iptables -I INPUT -i lo -p tcp --dport "$port" -j ACCEPT

    # Allow each bound interface
    while IFS= read -r iface; do
        iface=$(echo "$iface" | tr -d '[:space:]')
        [ -z "$iface" ] && continue
        iptables -I INPUT -i "$iface" -p tcp --dport "$port" -j ACCEPT
    done < "$bind_file"

    return 0
}

flush_adb_rules() {
    local port=$1

    # Remove all iptables rules referencing the ADB port
    while iptables -L INPUT -n --line-numbers 2>/dev/null | grep -q "dpt:$port"; do
        local line=$(iptables -L INPUT -n --line-numbers 2>/dev/null | grep "dpt:$port" | head -1 | awk '{print $1}')
        [ -z "$line" ] && break
        iptables -D INPUT "$line" 2>/dev/null
    done
    return 0
}

rebuild_bindings() {
    local port=$(get_adb_port)
    if [ -z "$port" ]; then
        echo -e "${YELLOW}ADB is not enabled. Enable it first with 'wadbd on <port>'${NC}"
        return 1
    fi
    apply_iptables_rules "$port" "$BIND_FILE"
    return 0
}

bind_interface() {
    local iface="$1"

    if [ -z "$iface" ]; then
        echo -e "${PINK}Error: No interface specified.${NC}"
        echo -e "${YELLOW}Usage: wadbd bind <interface>${NC}"
        return 1
    fi

    # Check interface exists
    if ! ip link show "$iface" >/dev/null 2>&1; then
        echo -e "${PINK}Error: Interface '$iface' does not exist.${NC}"
        echo -e "${YELLOW}Available interfaces:${NC}"
        ip link show | grep -E '^[0-9]+:' | awk -F': ' '{print "  " $2}' | grep -v '^lo$'
        return 1
    fi

    local port=$(get_adb_port)
    if [ -z "$port" ]; then
        echo -e "${YELLOW}ADB is not enabled. Enabling on port 5555 first...${NC}"
        enable_wireless_adb 5555
        port=5555
    fi

    # Check if already bound
    if [ -f "$BIND_FILE" ] && grep -qx "$iface" "$BIND_FILE" 2>/dev/null; then
        echo -e "${YELLOW}Interface '$iface' is already bound.${NC}"
        return 0
    fi

    # Add to bind file
    mkdir -p "$MODULE_PATH"
    echo "$iface" >> "$BIND_FILE"

    # Rebuild iptables
    apply_iptables_rules "$port" "$BIND_FILE"

    # Fetch IP separately (avoid toybox sh local+subshell scoping bug)
    local _ip_addr
    _ip_addr=$(ip -f inet addr show "$iface" 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 | awk '{print $2}')
    echo -e "${GREEN} => ADB bound to interface '$iface'${NC}"
    [ -n "$_ip_addr" ] && echo -e "${GREEN}    IP: $_ip_addr | Connect: adb connect $_ip_addr:$port${NC}"
    echo -e "${YELLOW}    ADB is now restricted to this interface + localhost only.${NC}"

    return 0
}

unbind_interface() {
    local iface="$1"

    if [ -z "$iface" ]; then
        echo -e "${PINK}Error: No interface specified.${NC}"
        echo -e "${YELLOW}Usage: wadbd unbind <interface>${NC}"
        return 1
    fi

    if [ ! -f "$BIND_FILE" ] || ! grep -qx "$iface" "$BIND_FILE" 2>/dev/null; then
        echo -e "${YELLOW}Interface '$iface' is not bound.${NC}"
        return 0
    fi

    # Remove from file
    local tmp=$(mktemp)
    grep -vx "$iface" "$BIND_FILE" > "$tmp" 2>/dev/null
    mv "$tmp" "$BIND_FILE"

    # If no more interfaces, remove the file entirely
    if [ ! -s "$BIND_FILE" ]; then
        rm -f "$BIND_FILE"
    fi

    local port=$(get_adb_port)
    if [ -n "$port" ]; then
        if [ -f "$BIND_FILE" ]; then
            apply_iptables_rules "$port" "$BIND_FILE"
            echo -e "${GREEN} => Interface '$iface' unbound.${NC}"
        else
            flush_adb_rules "$port"
            echo -e "${GREEN} => Interface '$iface' unbound. ADB now open on all interfaces.${NC}"
        fi
    else
        echo -e "${GREEN} => Interface '$iface' unbound.${NC}"
    fi

    return 0
}

unbind_all() {
    if [ -f "$BIND_FILE" ]; then
        rm -f "$BIND_FILE"
    fi

    local port=$(get_adb_port)
    if [ -n "$port" ]; then
        flush_adb_rules "$port"
    fi

    echo -e "${GREEN} => All interface restrictions removed. ADB open on all interfaces.${NC}"
    return 0
}

bind_status() {
    local port=$(get_adb_port)

    echo -e "${YELLOW}── ADB Binding Status ──${NC}"

    if [ -z "$port" ]; then
        echo -e "${PINK}  ADB is disabled.${NC}"
        return 0
    fi

    echo -e "${GREEN}  ADB port: $port${NC}"

    if [ ! -f "$BIND_FILE" ] || [ ! -s "$BIND_FILE" ]; then
        echo -e "${YELLOW}  No interface restrictions — ADB is open on ALL interfaces.${NC}"
        return 0
    fi

    echo -e "${GREEN}  Bound interfaces:${NC}"
    while IFS= read -r iface; do
        iface=$(echo "$iface" | tr -d '[:space:]')
        [ -z "$iface" ] && continue
        local state=$(ip link show "$iface" 2>/dev/null | grep -oE 'state [A-Z]+' | awk '{print $2}')
        local ip_addr=$(ip -f inet addr show "$iface" 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 | awk '{print $2}')
        local state_color="$GREEN"
        [ "$state" != "UP" ] && state_color="$RED"
        echo -e "    $iface  ${state_color}($state)${NC}  $ip_addr"
    done < "$BIND_FILE"

    echo ""
    echo -e "${YELLOW}  Active iptables rules for ADB:${NC}"
    iptables -L INPUT -n 2>/dev/null | grep "dpt:$port" | while read -r rule; do
        echo -e "    $rule"
    done

    return 0
}

list_interfaces() {
    echo -e "${YELLOW}Available network interfaces:${NC}"
    ip link show | grep -E '^[0-9]+:' | awk -F': ' '{print $2}' | while read -r iface; do
        [ "$iface" = "lo" ] && continue
        local state=$(ip link show "$iface" 2>/dev/null | grep -oE 'state [A-Z]+' | awk '{print $2}')
        local ip_addr=$(ip -f inet addr show "$iface" 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 | awk '{print $2}')
        local mac=$(ip link show "$iface" 2>/dev/null | grep -oE 'link/ether ([0-9a-f]{2}:){5}[0-9a-f]{2}' | awk '{print $2}' | head -1)
        if [ -f "$BIND_FILE" ] && grep -qx "$iface" "$BIND_FILE" 2>/dev/null; then
            echo -e "  ${GREEN}[BOUND]${NC} $iface ($state) $ip_addr $mac"
        else
            echo -e "  $iface ($state) $ip_addr $mac"
        fi
    done
    return 0
}

# ─── Original WADBD Commands (with binding integration) ────────────

enable_wireless_adb() {
    local port=${1:-5555} 
    echo "$port" | grep -qE '^[0-9]+$'
    if [ $? -ne 0 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo -e "${PINK}Error: Invalid port number.${NC}"
        exit 1
    fi

    setprop service.adb.tcp.port "$port"
    stop adbd
    start adbd

    # Apply iptables binding if any interfaces are configured
    sleep 1
    if [ -f "$BIND_FILE" ] && [ -s "$BIND_FILE" ]; then
        apply_iptables_rules "$port" "$BIND_FILE"
    fi

    echo -e "${GREEN} => Wireless ADB enabled on port $port.${NC}"
    show_default_gateway
    su -lp 2000 -c "cmd notification post -S bigtext -t 'WADBD' 'Tag' 'Wireless ADBD Enabled on port $port !!'" > /dev/null 2>&1
}

show_default_gateway() {
    local port=$(getprop service.adb.tcp.port)
    
    if [ "$port" -eq -1 ]; then
        echo -e "${PINK} => Wireless ADB is disabled.${NC}"
        return
    fi

    # Show bound interfaces first if any
    if [ -f "$BIND_FILE" ] && [ -s "$BIND_FILE" ]; then
        echo -e "${YELLOW} => (Restricted mode — only bound interfaces accessible)${NC}"
        while IFS= read -r iface; do
            iface=$(echo "$iface" | tr -d '[:space:]')
            [ -z "$iface" ] && continue
            local ip_addr=$(ip -f inet addr show "$iface" 2>/dev/null | grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 | awk '{print $2}')
            [ -n "$ip_addr" ] && echo -e "${GREEN}   • adb connect $ip_addr:$port${NC}"
        done < "$BIND_FILE"
        return
    fi

    # Otherwise show all non-loopback IPs
    ips=$(ip -f inet addr show | grep -Eo 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | awk '{print $2}' | grep -v '^127\.0\.0\.1$')
    
    if [ -n "$ips" ]; then
        echo -e "${PINK} => The following commands can be used to connect wirelessly:${NC}"
        for ip in $ips; do
            echo -e "${GREEN}   • adb connect $ip:$port${NC}"
        done
    else
        echo -e "${PINK} => No usable IP addresses found. Ensure your device is connected to a network.${NC}"
    fi
}

disable_wireless_adb() {
    local port=$(get_adb_port)
    if [ -n "$port" ]; then
        flush_adb_rules "$port"
    fi
    setprop service.adb.tcp.port -1
    stop adbd
    start adbd
    echo -e "${GREEN} => Wireless ADB disabled.${NC}"
}

check_wireless_adb_status() {
    port=$(getprop service.adb.tcp.port)
    
    if [ "$port" != "-1" ] && [ -n "$port" ]; then
        echo -e "${GREEN} => Wireless ADB is enabled on port $port.${NC}"
        show_default_gateway 
    else
        echo -e "${PINK} => Wireless ADB is disabled.${NC}"
    fi
    
    # Check binding state
    if [ -f "$BIND_FILE" ] && [ -s "$BIND_FILE" ]; then
        local count=$(wc -l < "$BIND_FILE" | tr -d ' ')
        echo -e "${GREEN} => Interface binding: $count interface(s) restricted${NC}"
    fi
    
    # Check if wireless ADB is enabled on boot
    local module_path="/data/adb/modules/wadbd/service.sh"
    if [ -f "$module_path" ]; then
        boot_port=$(awk '/setprop service.adb.tcp.port/ {print $3}' "$module_path")
        if [ -n "$boot_port" ]; then
            echo -e "${GREEN} => Wireless ADB on boot is enabled on port $boot_port.${NC}"
        else
            echo -e "${PINK} => Wireless ADB on boot is not set correctly.${NC}"
        fi
    else
        echo -e "${PINK} => Wireless ADB on boot is disabled.${NC}"
    fi
}

enable_on_boot() {
    local port=${1:-5555}
    echo "$port" | grep -qE '^[0-9]+$'
    if [ $? -ne 0 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo -e "${PINK} => Error: Invalid port number.${NC}"
        exit 1
    fi

    local module_path="/data/adb/modules/wadbd"
    mkdir -p "$module_path"

    # Build service.sh with binding support
    cat >"$module_path/service.sh" <<SERVICEEOF
#!/system/bin/sh
while [ "\$(getprop sys.boot_completed)" != "1" ]; do
    sleep 2
done
setprop service.adb.tcp.port $port
stop adbd
start adbd
sleep 1

# Apply interface bindings from boot
BIND_FILE="/data/adb/modules/wadbd/bind_ifaces"
if [ -f "\$BIND_FILE" ] && [ -s "\$BIND_FILE" ]; then
    # Flush existing
    while iptables -L INPUT -n --line-numbers 2>/dev/null | grep -q "dpt:$port"; do
        local line=\$(iptables -L INPUT -n --line-numbers 2>/dev/null | grep "dpt:$port" | head -1 | awk '{print \$1}')
        [ -z "\$line" ] && break
        iptables -D INPUT "\$line" 2>/dev/null
    done
    iptables -A INPUT -p tcp --dport "$port" -j DROP
    iptables -I INPUT -i lo -p tcp --dport "$port" -j ACCEPT
    while IFS= read -r iface; do
        iface=\$(echo "\$iface" | tr -d '[:space:]')
        [ -z "\$iface" ] && continue
        iptables -I INPUT -i "\$iface" -p tcp --dport "$port" -j ACCEPT
    done < "\$BIND_FILE"
fi

su -lp 2000 -c "cmd notification post -S bigtext -t 'WADBD' 'Tag' 'Wireless ADBD Enabled on port $port !!'" > /dev/null 2>&1
exit
SERVICEEOF
    chmod 755 "$module_path/service.sh"
    echo -e "${GREEN} => Wireless ADB will now be enabled on boot with port $port.${NC}"
    su -lp 2000 -c "cmd notification post -S bigtext -t 'WADBD' 'Tag' 'Wireless ADB on boot will now be Enabled on port $port !!'" > /dev/null 2>&1
}

disable_on_boot() {
    local module_path="/data/adb/modules/wadbd"
    if [ -f "$module_path/service.sh" ]; then
        rm -f "$module_path/service.sh"
        echo -e "${GREEN} => Wireless ADB will no longer be enabled on boot.${NC}"
    else
        echo -e "${PINK} => Wireless ADB on boot is already disabled.${NC}"
    fi
}

remove_keys(){
    rm -f /data/misc/adb/adb_keys
    rm -f /data/misc/adb/adb_temp_keys.xml
    echo -e "${PINK}ADB keys cleared successfully.${NC}"
}

validate_adbkey_pub() {
    local key_file="$1"
    if ! head -n 1 "$key_file" | grep -qE '^QAAA'; then
        echo -e "${PINK}Error: Invalid adbkey format. Expected a valid ADB public key.${NC}"
        exit 1
    fi
    local key_length=$(head -n 1 "$key_file" | base64 -d 2>/dev/null | wc -c)
    if [ "$key_length" -lt 256 ]; then
        echo -e "${PINK}Error: Key length is too short to be a genuine adbkey.pub.${NC}"
        exit 1
    fi
    echo -e "${GREEN}Validation successful.${NC}"
}

import_adb_key() {
    local key_file="$1"
    local adb_keys_file="/data/misc/adb/adb_keys"

    if [ ! -f "$key_file" ]; then
        echo -e "${PINK}Error: File not found at $key_file.${NC}"
        exit 1
    fi

    validate_adbkey_pub "$key_file"
    if [ ! -f "$adb_keys_file" ]; then
        mkdir -p "$(dirname "$adb_keys_file")"
        touch "$adb_keys_file"
        chmod 640 "$adb_keys_file"
        chown 1000:2000 "$adb_keys_file"
    fi
    
    if grep -qFf "$key_file" "$adb_keys_file"; then
        echo -e "${PINK}Key is already present in adb_keys.${NC}"
    else
        cat "$key_file" >>"$adb_keys_file"
        echo "" >>"$adb_keys_file"  
        echo -e "${GREEN}Key imported successfully to adb_keys.${NC}"
    fi
}

SIGNATURE=$(echo "ADB_KEYS_BACKUP" | sha256sum | cut -d' ' -f1)

backup_adb_keys() {
    local backup_path=$1
    if [ -z "$backup_path" ]; then
        echo -e "${PINK}Error: No backup path provided.${NC}"
        exit 1
    fi

    if [ ! -f /data/misc/adb/adb_keys ]; then
        echo -e "${PINK}Error: adb_keys file does not exist.${NC}"
        exit 1
    fi

    if [ -d "$backup_path" ]; then
        backup_path="$backup_path/keys_backup"
    fi
    echo -n "$SIGNATURE" > "$backup_path"
    cat /data/misc/adb/adb_keys >> "$backup_path"
    echo -e "${GREEN}ADB keys backed up to $backup_path.${NC}"
}

restore_adb_keys() {
    local backup_path=$1
    if [ -z "$backup_path" ]; then
        echo -e "${PINK}Error: No backup file provided.${NC}"
        exit 1
    fi
    if [ ! -f "$backup_path" ]; then
        echo -e "${PINK}Error: Backup file not found at $backup_path.${NC}"
        exit 1
    fi
    local file_signature=$(head -c 64 "$backup_path")
    if [ "$file_signature" != "$SIGNATURE" ]; then
        echo -e "${PINK}Error: Invalid signature. Restoration aborted.${NC}"
        exit 1
    fi
    tail -c +65 "$backup_path" > /data/misc/adb/adb_keys
    chmod 640 /data/misc/adb/adb_keys
    chown 1000:2000 /data/misc/adb/adb_keys
    echo -e "${GREEN}ADB keys restored successfully from $backup_path.${NC}"
}

# ─── Main ──────────────────────────────────────────────────────────

check_root
if [ "$#" -lt 1 ]; then
    usage
fi

case "$1" in
    --import-key)
        if [ -z "$2" ]; then
            echo -e "${PINK}Error: Path to adbkey.pub is required.${NC}"
            usage
        fi
        import_adb_key "$2"
        ;;
    on)
        enable_wireless_adb "$2"
        ;;
    off)
        disable_wireless_adb
        ;;
    status)
        check_wireless_adb_status
        ;;
    enable-on-boot)
        enable_on_boot "$2"
        ;;
    disable-on-boot)
        disable_on_boot
        ;;
    bind)
        bind_interface "$2"
        ;;
    unbind)
        unbind_interface "$2"
        ;;
    unbind-all)
        unbind_all
        ;;
    bind-status)
        bind_status
        ;;
    list-interfaces)
        list_interfaces
        ;;
    --clear-keys)
        remove_keys
        ;;
    --backup)
        backup_adb_keys "$2"
        ;;
    --restore)
        restore_adb_keys "$2"
        ;;
    *)
        usage
        ;;
esac
